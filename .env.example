# Copy to .env (git-ignored) for docker compose. Never commit real values.
# Generate each password with:  openssl rand -base64 32
# In recf/qua/prod these values come from the secret manager, not from a file.

# --- Shared by Admin Server and monolith -------------------------------------------------------------
# Registration account (ROLE_CLIENT on the Admin Server).
ADMIN_CLIENT_USER=monolith-registration
ADMIN_CLIENT_PASSWORD=

# --- Monolith -----------------------------------------------------------------------------------------
# Admin Server URL (compose sets it to http://admin-server:8081).
ADMIN_SERVER_URL=http://localhost:8081
# Technical Actuator account (role ACTUATOR on the monolith). Must differ from the registration account.
ACTUATOR_USER=sba-actuator
ACTUATOR_PASSWORD=
# Optional: LOG_FILE_NAME, MANAGEMENT_PORT (qua/prod, default 9090), ADMIN_CLIENT_SERVICE_HOST_TYPE (ip)

# --- Admin Server, dev profile only (local users) -------------------------------------------------------
DEV_ADMIN_USER=admin
DEV_ADMIN_PASSWORD=
DEV_VIEWER_USER=viewer
DEV_VIEWER_PASSWORD=

# --- Admin Server, recf / qua / prod (OIDC with ADFS or Entra ID) ----------------------------------------
# ADMIN_PORT=8081
# OIDC_ISSUER_URI=https://adfs.example.com/adfs
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_GROUPS=SBA-Admin-PROD
# recf/qua only: prod has no viewer role (admin.security.viewer-enabled=false).
# OIDC_VIEWER_GROUPS=SBA-Viewer-QUA
# prod only: internal port for the Admin Server's own /actuator/health (default 9091).
# ADMIN_MANAGEMENT_PORT=9091
# OIDC_GROUP_CLAIMS=groups,group,roles,role
# OIDC_USERNAME_ATTRIBUTE=upn
# OIDC_SCOPES=openid,profile,email,allatclaims

# --- Admin Server notifications (optional) -----------------------------------------------------------------
# MAIL_NOTIFY_ENABLED=true
# MAIL_NOTIFY_TO=ops@example.com
# MAIL_NOTIFY_FROM=Spring Boot Admin <noreply@example.com>
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# TEAMS_NOTIFY_ENABLED=true
# TEAMS_WEBHOOK_URL=
